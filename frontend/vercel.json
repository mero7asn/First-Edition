{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "headers": {
        "cache-control": "s-maxage=31536000,immutable"
      },
      "dest": "/static/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/favicon.ico"
    },
    {
      "src": "/logo.png",
      "dest": "/logo.png"
    },
    {
      "src": "/devtools-block.js",
      "dest": "/devtools-block.js"
    },
    {
      "src": "/screenshot-block.js",
      "dest": "/screenshot-block.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
